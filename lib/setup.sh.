#!/bin/bash
cd /workspaces/Netwalk
grep -q NSHealthShare ios/Runner/Info.plist || python3 -c "p='ios/Runner/Info.plist';s=open(p).read();i=s.rindex('</dict>');s=s[:i]+'<key>NSHealthShareUsageDescription</key><string>NETWALK reads your step count to award walking rewards.</string><key>NSHealthUpdateUsageDescription</key><string>NETWALK does not write health data.</string>'+s[i:];open(p,'w').write(s)"
echo '<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict><key>com.apple.developer.healthkit</key><true/><key>com.apple.developer.healthkit.access</key><array/></dict></plist>' > ios/Runner/Runner.entitlements
grep -q CODE_SIGN_ENTITLEMENTS ios/Runner.xcodeproj/project.pbxproj || sed -i 's#PRODUCT_BUNDLE_IDENTIFIER = com.rawcrestline.netwalk;#&\n\t\t\t\tCODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements;#' ios/Runner.xcodeproj/project.pbxproj
echo "CHECK RESULTS:"
grep -c NSHealthShare ios/Runner/Info.plist
grep -c CODE_SIGN_ENTITLEMENTS ios/Runner.xcodeproj/project.pbxproj
ls ios/Runner/Runner.entitlements
